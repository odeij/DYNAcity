  "cards": [
    {
      "dot": "emerald",
      "title": "Time-forward validation",
      "items": [
        "Train on 2018→2022, test on 2022→2024",
        "2018→2024 is descriptive only and never reaches train or test",
        "The gradient-boosting model ships only if it beats both baselines on macro-F1 and Brier; otherwise the best baseline ships"
      ]
    },
    {
      "dot": "cyan",
      "title": "Forecast engine",
      "items": [
        "8 canonical building states, one 2-year step at a time",
        "Monte Carlo draws give p05/p50/p95 KPI bands at 2, 4 and 6 years"
      ]
    },
    {
      "dot": "rose",
      "title": "LLM guardrails",
      "items": [
        "The LLM drafts structure; code checks scope and sets every number",
        "Only aggregate allowlisted attributes are sent, never per-building rows",
        "Map answers are computed and phrased by code"
      ]
    },
    {
      "dot": "slate",
      "title": "Optional and offline",
      "items": [
        "Every step also runs from the dynacity CLI",
        "Point-cloud features are banned from 2018→2022 rows (captured after the 2020 blast)",
        "The Beirut 001 pack and the Unreal project stay in the private data root; the pack is served on loopback only"
      ]
    },
    {
      "dot": "amber",
      "title": "Mobility twin",
      "items": [
        "Roads come from OpenStreetMap; speeds are Tari'ak 2014–2019 medians, counts are CDR 2016–17",
        "SUMO replays generated trips; closures and crashes use uncalibrated rules",
        "Traffic never feeds the transition model; the page only gets per-road aggregates"
      ]
    }
  ]
}